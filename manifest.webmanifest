{
  "id": "./",
  "name": "FileForge - File Toolkit",
  "short_name": "FileForge",
  "description": "Local-first file toolkit for Android. Images, PDF, ZIP, audio, video and safe link sharing.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#090f18",
  "theme_color": "#0a111b",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "categories": [
    "productivity",
    "utilities",
    "photo",
    "video"
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "ff_share_title",
      "text": "ff_share_text",
      "url": "ff_share_url"
    }
  }
}
